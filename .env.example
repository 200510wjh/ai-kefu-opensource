# Server
MERCHANT_AUTO_CUT_DATA_DIR=./data
APP_PUBLIC_BASE_URL=https://wjhai.cn/merchant-admin

# Optional AI providers. Never commit real keys.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TEMPERATURE=0.85
AI_TIMEOUT=35
OPENAI_API_KEY=
MINIMAX_CN_API_KEY=
ANTHROPIC_API_KEY=

# Optional image generation provider. Works with API2D/OpenAI-compatible /v1/images/generations.
IMAGE_PROVIDER=openai_compatible
IMAGE_BASE_URL=https://oa.api2d.net
# For API2D image endpoint, api2d-default omits model from request body.
IMAGE_MODEL=api2d-default
IMAGE_API_KEY=
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT=80

# Future integrations
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional real connector probe. Leave empty for open-source demo mode.
REAL_CONNECTOR_NAME=official_connector
REAL_CONNECTOR_ACCESS_TOKEN=
REAL_CONNECTOR_AUTH_HEADER=Authorization: Bearer {token}
REAL_CONNECTOR_MESSAGES_URL=
REAL_CONNECTOR_LEADS_URL=
REAL_CONNECTOR_LIMIT=3
APP_DEMO_USERNAME=admin
APP_DEMO_PASSWORD=admin123

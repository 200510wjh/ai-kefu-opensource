# Server
MERCHANT_AUTO_CUT_DATA_DIR=./data

# Optional AI providers. Never commit real keys.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TEMPERATURE=0.85
AI_TIMEOUT=35
OPENAI_API_KEY=
MINIMAX_CN_API_KEY=
ANTHROPIC_API_KEY=

# Optional image generation provider. Works with API2D/OpenAI-compatible /v1/images/generations.
IMAGE_PROVIDER=openai_compatible
IMAGE_BASE_URL=https://oa.api2d.net
# For API2D image endpoint, api2d-default omits model from request body.
IMAGE_MODEL=api2d-default
IMAGE_API_KEY=
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT=80

# Future integrations
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

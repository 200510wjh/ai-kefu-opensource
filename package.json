    "desktop:agent": "C:\\Users\\Administrator\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe scripts/desktop_agent_runner.py --config scripts/desktop_listener.config.example.json",
    "desktop:downloads": "C:\\Users\\Administrator\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe scripts/build_desktop_agent_downloads.py",

  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "cn.wjhai.merchant-ai",
    "productName": "商家AI增长工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/electron/**/*",
      "desktop_agent/**/*",
      "scripts/desktop_agent_runner.py",
      "scripts/desktop_listener.config.example.json",
      "scripts/desktop_auto_reply_listener.py",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "商家AI增长工作台",
      "artifactName": "${productName}-${version}-mac.${ext}"
    }

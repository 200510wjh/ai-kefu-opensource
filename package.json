    "acceptance:open-source-demo": "python scripts/open_source_connector_demo.py",
    "acceptance:real-connector": "python scripts/real_connector_probe.py",
    "demand:scan": "C:\\Users\\Administrator\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe scripts/local_demand_radar.py",

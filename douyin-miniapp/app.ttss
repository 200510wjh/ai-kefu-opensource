page {
  min-height: 100%;
  color: #f8fbff;
  background: #090b16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx;
}

.glass {
  box-sizing: border-box;
  background: #111827;
  border: 1rpx solid #263449;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.22);
}

.eyebrow {
  color: #a7f3d0;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
  background: #facc15;
  border-radius: 999rpx;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  color: #e5efff;
  font-size: 28rpx;
  font-weight: 800;
  background: #172033;
  border: 1rpx solid #2c3b52;
  border-radius: 999rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field text {
  color: #cbd5e1;
  font-size: 24rpx;
  font-weight: 800;
}

input,
textarea,
picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  padding: 22rpx 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  background: #0f172a;
  border: 1rpx solid #334155;
  border-radius: 18rpx;
}

textarea {
  min-height: 156rpx;
}

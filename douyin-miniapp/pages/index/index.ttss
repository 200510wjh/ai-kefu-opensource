.ecom-page {
  padding-bottom: 48rpx;
}

.hero-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 42rpx 28rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #07111f 0%, #11113a 48%, #210b3f 100%);
  border: 1rpx solid rgba(132, 180, 255, 0.42);
  border-radius: 34rpx;
  box-shadow: 0 32rpx 80rpx rgba(36, 91, 255, 0.28);
}

.hero-card::after {
  position: absolute;
  right: -140rpx;
  bottom: -160rpx;
  width: 420rpx;
  height: 420rpx;
  content: "";
  background: radial-gradient(circle, rgba(0, 216, 255, 0.34), rgba(128, 42, 255, 0));
}

.top-pill {
  align-self: center;
  padding: 14rpx 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  background: rgba(8, 18, 42, 0.72);
  border: 1rpx solid rgba(205, 219, 255, 0.62);
  border-radius: 999rpx;
}

.mega-title {
  color: #ffffff;
  font-size: 76rpx;
  font-weight: 950;
  line-height: 1.06;
  text-align: center;
  text-shadow: 0 0 28rpx rgba(104, 198, 255, 0.6);
}

.sub-band {
  align-self: center;
  width: 88%;
  padding: 18rpx 24rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 950;
  text-align: center;
  background: linear-gradient(90deg, #8d36ff, #315dff);
  border-radius: 18rpx;
}

.feature-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(7, 17, 32, 0.64);
  border: 1rpx solid rgba(112, 149, 255, 0.34);
  border-radius: 24rpx;
}

.feature-row text {
  color: #dbeafe;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
}

.quick-cases {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
  overflow-x: auto;
}

.case-chip {
  flex: 0 0 210rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 22rpx;
  color: #e5efff;
  background: rgba(17, 24, 39, 0.92);
  border: 1rpx solid #2c3b52;
  border-radius: 24rpx;
}

.case-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #206aff, #9238ff);
  border-color: #98c8ff;
}

.case-chip text:first-child {
  font-size: 28rpx;
  font-weight: 950;
}

.case-chip text:last-child {
  color: #bfe8ff;
  font-size: 22rpx;
}

.generator-card {
  position: relative;
  min-height: 520rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  background: linear-gradient(165deg, #07111f, #101b40 58%, #261052);
  border: 1rpx solid rgba(111, 152, 255, 0.45);
  border-radius: 34rpx;
}

.mock-screen {
  display: flex;
  min-height: 380rpx;
  overflow: hidden;
  background: #0a1224;
  border: 2rpx solid rgba(126, 161, 255, 0.42);
  border-radius: 26rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.34);
}

.mock-sidebar {
  width: 188rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 16rpx;
  background: rgba(4, 10, 24, 0.7);
}

.mock-sidebar text {
  color: #8ca5c8;
  font-size: 22rpx;
  font-weight: 800;
}

.mock-sidebar .active-dot {
  color: #ffffff;
  padding: 12rpx;
  background: linear-gradient(90deg, #315dff, #9333ea);
  border-radius: 12rpx;
}

.mock-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx;
}

.preview-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 10rpx;
  padding: 24rpx;
  color: #ffffff;
  background: linear-gradient(155deg, #e9f8ff, #6db8ff 45%, #4338ca);
  border-radius: 22rpx;
}

.preview-box text:first-child {
  font-size: 34rpx;
  font-weight: 950;
}

.preview-box text:last-child {
  font-size: 30rpx;
  font-weight: 950;
}

.thumb-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.thumb-row text {
  padding: 18rpx 0;
  color: #dbeafe;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
  background: #121d37;
  border-radius: 14rpx;
}

.floating-card {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 18rpx;
  color: #ffffff;
  background: rgba(66, 39, 189, 0.86);
  border: 1rpx solid rgba(188, 219, 255, 0.65);
  border-radius: 22rpx;
  box-shadow: 0 0 36rpx rgba(82, 157, 255, 0.5);
}

.floating-card text:first-child {
  font-size: 24rpx;
  font-weight: 950;
}

.floating-card text:last-child {
  color: #c7f9ff;
  font-size: 22rpx;
}

.left-card {
  left: 28rpx;
  bottom: 26rpx;
  max-width: 260rpx;
}

.right-card {
  right: 28rpx;
  bottom: 26rpx;
  max-width: 220rpx;
}

.form-card,
.three-steps {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 28rpx;
  background: rgba(12, 18, 37, 0.96);
  border: 1rpx solid rgba(86, 116, 166, 0.55);
  border-radius: 30rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-head text:first-child,
.steps-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 950;
}

.section-head text:last-child {
  color: #9cc7ff;
  font-size: 24rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field.half {
  flex: 1;
}

.picker-box {
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  padding: 22rpx 24rpx;
  color: #ffffff;
  font-size: 26rpx;
  background: #0f172a;
  border: 1rpx solid #334155;
  border-radius: 18rpx;
}

.neon-button {
  color: #ffffff;
  background: linear-gradient(90deg, #1e6fff, #9b35ff);
  box-shadow: 0 0 36rpx rgba(63, 129, 255, 0.5);
}

.three-steps {
  margin-top: 24rpx;
}

.step-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.step-card {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 950;
  text-align: center;
  background: rgba(24, 37, 72, 0.94);
  border: 1rpx solid rgba(111, 173, 255, 0.46);
  border-radius: 22rpx;
}

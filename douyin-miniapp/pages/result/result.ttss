.result-page {
  padding-bottom: 58rpx;
}

.result-hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 34rpx 28rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #07111f 0%, #101b40 54%, #2a0f4f 100%);
  border: 1rpx solid rgba(132, 180, 255, 0.42);
  border-radius: 34rpx;
  box-shadow: 0 30rpx 70rpx rgba(36, 91, 255, 0.26);
}

.result-title {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1.12;
}

.result-subtitle {
  color: #bfe8ff;
  font-size: 28rpx;
  font-weight: 800;
}

.boundary-pill {
  align-self: flex-start;
  padding: 12rpx 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  background: linear-gradient(90deg, #235dff, #9434ff);
  border-radius: 999rpx;
}

.product-preview {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  background: #0b1224;
  border: 1rpx solid rgba(95, 137, 211, 0.5);
  border-radius: 30rpx;
}

.poster-preview {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 28rpx;
  color: #ffffff;
  background: linear-gradient(155deg, #eafaff, #73c4ff 38%, #5b4bff 64%, #1a0b3b 100%);
  border-radius: 26rpx;
  box-shadow: 0 0 44rpx rgba(89, 172, 255, 0.34);
}

.poster-preview text:first-child {
  font-size: 42rpx;
  font-weight: 950;
}

.poster-preview text:nth-child(2) {
  font-size: 30rpx;
  font-weight: 900;
}

.poster-preview text:last-child {
  font-size: 36rpx;
  font-weight: 950;
}

.listing-fields {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx;
  background: #111b33;
  border: 1rpx solid #253756;
  border-radius: 20rpx;
}

.listing-fields text {
  color: #dbeafe;
  font-size: 24rpx;
  line-height: 1.45;
}

.action-card,
.section-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  background: rgba(12, 18, 37, 0.96);
  border: 1rpx solid rgba(86, 116, 166, 0.55);
  border-radius: 28rpx;
}

.image-result-card {
  gap: 20rpx;
}

.media-pack-card {
  gap: 20rpx;
}

.managed-card {
  border-color: rgba(119, 231, 255, 0.44);
  background: linear-gradient(155deg, rgba(11, 18, 36, 0.98), rgba(31, 22, 68, 0.96));
}

.managed-offer {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.5;
}

.managed-position {
  color: #bfe8ff;
  font-size: 24rpx;
  line-height: 1.5;
}

.package-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.package-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-height: 184rpx;
  padding: 18rpx;
  background: #0f172a;
  border: 1rpx solid rgba(119, 231, 255, 0.34);
  border-radius: 20rpx;
}

.package-card text:first-child {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 950;
}

.package-card text:nth-child(2) {
  color: #facc15;
  font-size: 26rpx;
  font-weight: 950;
}

.package-card text:last-child {
  color: #cbd5e1;
  font-size: 22rpx;
  line-height: 1.45;
}

.task-list,
.queue-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.task-row,
.queue-list view {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  background: #0f172a;
  border: 1rpx solid #253247;
  border-radius: 18rpx;
}

.task-row > text {
  flex: 0 0 92rpx;
  color: #77e7ff;
  font-size: 26rpx;
  font-weight: 950;
}

.task-row view,
.queue-list view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.task-row view text:first-child,
.queue-list text:nth-child(2) {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.45;
}

.task-row view text:last-child,
.queue-list text:last-child {
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.45;
}

.queue-list text:first-child {
  align-self: flex-start;
  padding: 6rpx 12rpx;
  color: #101827;
  font-size: 20rpx;
  font-weight: 950;
  background: #77e7ff;
  border-radius: 999rpx;
}

.generated-image {
  width: 100%;
  height: 680rpx;
  overflow: hidden;
  border: 1rpx solid rgba(119, 231, 255, 0.45);
  border-radius: 24rpx;
}

.tall-detail {
  height: 820rpx;
}

.generated-video {
  width: 100%;
  height: 680rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #000;
}

.video-fallback {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 18rpx;
  background: #0f172a;
  border: 1rpx solid #253247;
  border-radius: 18rpx;
}

.video-fallback text {
  color: #dbeafe;
  font-size: 24rpx;
  line-height: 1.5;
}

.image-status {
  color: #bfe8ff;
  font-size: 24rpx;
  line-height: 1.5;
}

.neon-button {
  color: #ffffff;
  background: linear-gradient(90deg, #1e6fff, #9b35ff);
  box-shadow: 0 0 34rpx rgba(63, 129, 255, 0.48);
}

.section-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 950;
}

.copy-row,
.prompt-card,
.sku-row,
.faq-row {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  color: #dbeafe;
  background: #0f172a;
  border: 1rpx solid #253247;
  border-radius: 18rpx;
}

.copy-row text:first-child,
.prompt-card text:first-child {
  flex: 0 0 38rpx;
  color: #77e7ff;
  font-size: 24rpx;
  font-weight: 950;
}

.copy-row text:last-child,
.prompt-card text:nth-child(2) {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.5;
}

.prompt-card {
  align-items: flex-start;
}

.prompt-card button {
  flex: 0 0 92rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  background: #325dff;
  border-radius: 999rpx;
}

.sku-row {
  justify-content: space-between;
}

.sku-row text {
  color: #dbeafe;
  font-size: 24rpx;
  font-weight: 800;
}

.faq-row {
  flex-direction: column;
}

.faq-row text {
  color: #dbeafe;
  font-size: 24rpx;
  line-height: 1.5;
}

.risk-card {
  border-color: rgba(250, 204, 21, 0.42);
}

.sticky-button {
  margin-top: 12rpx;
}
